# Example .env for fastApi-front
# Option A: point to a service account JSON file on disk
FIREBASE_CREDENTIALS_PATH=C:\path\to\serviceAccountKey.json

# Option B: alternatively, paste the full JSON content as a single-line string (use only one of the options)
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", "client_email": "..."}

# Collections (optional)
FIRESTORE_COLLECTION_TASKS=tasks
FIRESTORE_COLLECTION_USERS=users
